# Python caches and virtual environments
__pycache__/
*.py[cod]
*.pyo
*.pyd
.venv/
venv/
.env

# Jupyter
.ipynb_checkpoints/

# Local/private runtime files
*.db
*.sqlite
*.sqlite3
**/*.db
**/*.sqlite
**/*.sqlite3

# Local data and generated archives that must never be published
/data/
/data/raw/
/data/processed/
/data/output/
/output/
/models/
/logs/
/notebooks/
/IMPLEMENTATION_GUIDE.md
/IMPLEMENTATION_SUMMARY.md
/course_features_ver4.numbers
/update_race.bat

# Keep the raw-data directory placeholder
!data/raw/.gitkeep

# Generated local artifacts
*.pkl
*.joblib
*.h5
*.onnx
*.zip
*.tar
*.gz

# OS/editor noise
.DS_Store
Thumbs.db
.vscode/

# Explicitly keep public web assets tracked
!docs/
!docs/**/*.html
!docs/**/*.css
!docs/**/*.js
!docs/data/
!docs/data/**/*.json
